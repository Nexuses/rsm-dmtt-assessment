## Postgres (shared VPS Docker instance — see SHARED-INFRA.md / DEPLOY.md)
# Same host/user/password as other assessments on the VPS; UNIQUE database name.
# Keep connection_limit modest (shared max_connections=40). Example: &connection_limit=5
DATABASE_URL=postgresql://rsm:YOUR_PASSWORD@localhost:5432/dmtt_assessments?schema=public

# Password gate for /submissions admin UI (unique per app)
SUBMISSIONS_PASSWORD=

## Google Sheets (Service Account)
# 1) Create a Google Cloud service account
# 2) Enable "Google Sheets API"
# 3) Create a JSON key for the service account
# 4) Share your spreadsheet with the service account email (Editor access)
#
# Put the FULL JSON content of the key file below (as a single line JSON string).
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
#
# Your spreadsheet id (from the URL)
GOOGLE_SHEETS_SPREADSHEET_ID=17IoNsq0xAWSzJVgwnPC_Ej_eUGucW9iw6iVbvanUunE
#
# Tab names (optional)
GOOGLE_SHEETS_ASSESSMENT_SHEET_NAME=Sheet1
GOOGLE_SHEETS_CONSULTATION_SHEET_NAME=Sheet2

## Email (Resend SMTP) — required for existing email flows
# SMTP via nodemailer. SMTP_USER is the literal string "resend".
# SMTP_PASS is your Resend API key (re_...). FROM_EMAIL must use a domain
# verified in Resend, or mail will be rejected.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
FROM_EMAIL=

# Assessment & consultation notification recipients (comma-separated allowed)
NOTIFICATION_EMAIL=
REPLY_TO_EMAIL=
CONSULTATION_RECIPIENTS=

## AWS S3 (optional, for PDF upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=

