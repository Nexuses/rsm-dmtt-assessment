# Shared server block for https://hub.rsm.ae (install ONCE per VPS).
# Every assessment is a path on this host, e.g. /einvoicing-assessment, and adds
# its own location snippet in /etc/nginx/hub.rsm.ae.d/<name>.conf.
#
#   sudo mkdir -p /etc/nginx/hub.rsm.ae.d
#   sudo cp deploy/hub.rsm.ae.conf.example /etc/nginx/sites-available/hub.rsm.ae
#   sudo ln -s /etc/nginx/sites-available/hub.rsm.ae /etc/nginx/sites-enabled/hub.rsm.ae
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d hub.rsm.ae     # adds the 443 block and the http->https redirect

server {
    listen 80;
    listen [::]:80;
    server_name hub.rsm.ae;

    include /etc/nginx/hub.rsm.ae.d/*.conf;

    # The bare host has no page of its own.
    location = / {
        return 302 https://www.rsm.global/uae;
    }
}
