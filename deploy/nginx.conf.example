# Location snippet for https://hub.rsm.ae/dmtt-assessment
# Needs the shared hub server block (deploy/hub.rsm.ae.conf.example) first.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/hub.rsm.ae.d/dmtt-assessment.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# The path must match `basePath` in next.config.js. No trailing slash on
# proxy_pass, so nginx forwards the /dmtt-assessment prefix unchanged.

location ^~ /dmtt-assessment {
    client_max_body_size 25m;

    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}
